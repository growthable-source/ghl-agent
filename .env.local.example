OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
APP_URL=https://your-app.vercel.app
INSTALL_URL_STANDARD=

# Shared Secret(s) from the marketplace app settings — used to decrypt the
# SSO identity blob inside CRM iframes. _2 is for a second marketplace app
# (e.g. the agency portal-wrapper app) pointing at the same deployment.
LEADCONNECTOR_SSO_KEY=
LEADCONNECTOR_SSO_KEY_2=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://...?sslmode=require
DIRECT_URL=postgresql://...?sslmode=require

# Customer-portal auth. Falls back to NEXTAUTH_SECRET if unset, but a
# dedicated value keeps portal sessions independent of NextAuth rotations.
PORTAL_SESSION_SECRET=
# Optional override for the From address on portal invite emails.
# Falls back to NOTIFICATION_FROM_EMAIL.
PORTAL_FROM_EMAIL=

# ── Real-time Co-Pilot (screen-share + voice) ──────────────────────
# Server-side only — the browser receives short-lived ephemeral
# tokens, never this key. Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated workspace ids force-enabled pre-GA regardless of
# plan tier (dogfood allowlist). At GA the Scale plan flag gates it.
COPILOT_WORKSPACE_ALLOWLIST=
# Optional overrides (defaults shown)
# COPILOT_MODEL_PRIMARY=gemini-3.1-flash-live-preview
# COPILOT_MAX_SESSION_SECS=1800
# COPILOT_FRAME_FPS_CAP=1
# Optional prebuilt voice override (e.g. Puck, Kore). Accent otherwise
# follows the session locale, which follows the user's browser.
# COPILOT_VOICE=

# ── Voice agents (Vapi) ────────────────────────────────────────────────
# Server API key from dashboard.vapi.ai → Vapi API Keys. Gates all
# assistant registration, phone-number purchase, and outbound dialing.
VAPI_API_KEY=
# PUBLIC key (a separate value on the same Vapi dashboard page). The
# browser's @vapi-ai/web SDK needs it for test calls + widget voice.
# Without it the dashboard test-call preflight fails its first check.
VAPI_PUBLIC_KEY=
# Shared secret echoed back by Vapi as the x-vapi-secret header. When
# set, /api/vapi/webhook rejects requests without it — REQUIRED for a
# production deploy (the webhook executes booking/SMS/tagging tools).
# After setting or rotating it, re-save each voice agent so its
# registered assistant picks up the new secret.
VAPI_WEBHOOK_SECRET=
# Optional: ElevenLabs key for the extended voice catalogue.
ELEVENLABS_API_KEY=
# Optional model/transcriber overrides (defaults: openai/gpt-4.1 +
# deepgram/nova-3 — the stack verified end-to-end on Vapi).
# VAPI_DEFAULT_MODEL_PROVIDER=openai
# VAPI_DEFAULT_MODEL=gpt-4.1
# VAPI_DEFAULT_TRANSCRIBER_PROVIDER=deepgram
# VAPI_DEFAULT_TRANSCRIBER_MODEL=nova-3

# ─── Partner provisioning (help centre → AI chat widget) ─────────────
# The `globalKey` of the shared canonical knowledge collection every
# partner-provisioned agent reads. Resolved by key rather than cuid so
# the corpus can be rebuilt or renamed without a redeploy. Provisioning
# HARD-FAILS when this is unset or the collection isn't flagged
# isGlobal — an untrained agent is worse than a failed provision.
# Promote the collection with the SQL in
# prisma/sql/2026-08-07-global-knowledge-collections.sql.
CANONICAL_KNOWLEDGE_COLLECTION_KEY=
# Space-separated origins allowed to iframe the partner widget builder.
# Unlike the marketplace (thousands of unknowable whitelabel domains),
# the help centre runs on origins we control, so this gets a real CSP
# allowlist instead of frame-ancestors *. Unset falls back to '*'.
# NOTE: next.config.ts reads this BEFORE .env.local loads, so a value
# here has no effect locally — export it in your shell to test. It works
# on Vercel, where project env vars are real process-env entries.
PARTNER_FRAME_ANCESTORS=
# Trial length in days for partner-provisioned workspaces. Default 14.
PARTNER_TRIAL_DAYS=

# Post-unlock push to the help-center product (GKB): the admin unlock POSTs
# {externalId} to HELP_CENTER_SYNC_URL with this bearer secret so the widget
# and Pro flag land on the customer's help centre immediately — no manual
# sync. Secret must equal XOVERA_SYNC_SECRET on the GKB deployment.
# Unset = the unlock still works; GKB's admin has a manual Sync button.
HELP_CENTER_SYNC_URL=
HELP_CENTER_SYNC_SECRET=

# From-address for the Help Center onboarding email (admin → Help Center →
# "Onboarding email"). Must be a VERIFIED Resend sender on THIS deployment's
# Resend account. Unset falls back to the default transactional sender
# (NOTIFICATION_FROM_EMAIL). The email content is Growthable-branded either
# way; set this to a growthable.io address once it's verified in Resend.
ONBOARDING_FROM_EMAIL=

# ── Web push (operator browser notifications) ────────────────────────────
# A VAPID keypair. Both halves must come from the SAME generated pair —
# a public key that does not match the private key fails at signing time,
# which is a worse failure than being unset because it looks configured.
#
# Generate with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Production ran for 108 days with VAPID_PRIVATE_KEY set and the public key
# missing, so every push silently no-opped on "VAPID keys not configured".
# Both keys must be present on EVERY Vercel project that deploys this repo
# (dashboard AND widget runtime) — the widget runtime is where operator
# pushes actually fire from. NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined at
# build time, so adding it needs a rebuild, not just an env change.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address required by the Web Push spec. Defaults to
# mailto:notifications@xovera.io when unset.
VAPID_SUBJECT=

# ── Fleet health alerting ────────────────────────────────────────────────
# Where app/api/cron/fleet-health sends "the AI has stopped answering" and
# "the default model is serving nothing" alerts. Deliberately operator-level,
# not per-workspace: no customer should be paged because a provider key is
# missing. SUPER_ADMIN_EMAILS is shared with lib/help-auth.ts.
# Slack is optional; email still goes if it is unset or fails.
FLEET_ALERT_SLACK_WEBHOOK=
